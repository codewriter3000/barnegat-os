package app;

import lib.io.screen;

void dc8200_init = () -> {
    mmio<uint32> dc = 0xFFEF600000;

    offset(dc, 0x1CC0 / 4).value = 0x00000000;
    offset(dc, 0x1CC4 / 4).value = 0x00000000;
    fence();

    offset(dc, 0x1CD0 / 4).value = offset(dc, 0x1CD0 / 4).value & ~(1 << 3);
    offset(dc, 0x1CD4 / 4).value = offset(dc, 0x1CD4 / 4).value & ~(1 << 3);
    fence();

    offset(dc, 0x1418 / 4).value = 0x00001111;
    offset(dc, 0x141C / 4).value = 0x00001111;
    offset(dc, 0x14B8 / 4).value = 5;
    offset(dc, 0x14BC / 4).value = 5;
    offset(dc, 0x1430 / 4).value = 0x08980780;
    offset(dc, 0x1434 / 4).value = 0x08980780;
    offset(dc, 0x1438 / 4).value = 0x440207D8;
    offset(dc, 0x143C / 4).value = 0x440207D8;
    offset(dc, 0x1440 / 4).value = 0x04650438;
    offset(dc, 0x1444 / 4).value = 0x04650438;
    offset(dc, 0x1448 / 4).value = 0x4220843C;
    offset(dc, 0x144C / 4).value = 0x4220843C;

    offset(dc, 0x1528 / 4).value = RGB(0x00, 0x00, 0xFF);
    offset(dc, 0x152C / 4).value = RGB(0x00, 0xFF, 0x00);
    fence();

    offset(dc, 0x1404 / 4).value = 0x04200000;
    offset(dc, 0x140C / 4).value = 0x00001E00;
    offset(dc, 0x1814 / 4).value = (1080 << 15) | 1920;
    offset(dc, 0x151C / 4).value = (5 << 26);
    offset(dc, 0x1524 / 4).value = 0x00000030;
    offset(dc, 0x2514 / 4).value = 0x00000002;
    offset(dc, 0x2504 / 4).value = 0xFF000000;
    offset(dc, 0x250C / 4).value = 0xFF000000;
    offset(dc, 0x24DC / 4).value = 0x00000000;
    offset(dc, 0x24E4 / 4).value = (1080 << 15) | 1920;
    offset(dc, 0x1CC4 / 4).value = (1 << 19) | (1 << 13);
    offset(dc, 0x1CC4 / 4).value = offset(dc, 0x1CC4 / 4).value | (1 << 12);
    fence();

    uint32 panel_start = offset(dc, 0x1CCC / 4).value;
    panel_start = (panel_start & ~((1 << 2) | (1 << 3))) | (1 << 0) | (1 << 1);
    offset(dc, 0x1CCC / 4).value = panel_start;
    fence();
    exit;
};