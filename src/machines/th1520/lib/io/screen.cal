package app;

import lib.loop_while;

static final uint64 FB_PHYS_ADDR = 0x04200000;
static final mmio<uint32> FB_PHYS = 0x04200000;
static final int32 FB_WIDTH = 1920;
static final int32 FB_HEIGHT = 1080;
static final uint64 FB_STRIDE_BYTES = 0x00001E00;
static final uint64 FB_SIZE_BYTES = 0x007E9000;
static final uint64 THEAD_CMO_STRIDE = 32;

static final int32 SCREEN_OBJECT_KIND_RECT = 0;
static final int32 SCREEN_OBJECT_KIND_TEXT = 1;
static final int32 SCREEN_TEXT_CHAR_ADVANCE = 24;
static final int32 SCREEN_TEXT_HEIGHT = 32;

type ScreenObject = arr<?>;

uint32 RGB = (uint32 r, uint32 g, uint32 b) -> {
    return (r << 16) | (g << 8) | b;
};

bool fb_in_bounds = (int32 x, int32 y) -> {
    return x >= 0 && y >= 0 && x < FB_WIDTH && y < FB_HEIGHT;
};

void fb_write_pixel = (int32 x, int32 y, uint32 color) -> {
    mmio<uint32> fb = 0x04200000;

    offset(fb, y * 1920 + x).value = color;
    exit;
};

void fb_rect_span = (int32 x0, int32 x_end, int32 y, uint32 color) -> {
    int32 x = x0;

    while(() -> x < x_end, () -> {
        fb_write_pixel(x, y, color);
        x = x + 1;
    });

    exit;
};

void fb_rect = (int32 x0, int32 y0, int32 x1, int32 y1, uint32 color) -> {
    int32 y = y0;
    int32 x_end = x1 + 1;
    int32 y_end = y1 + 1;

    while(() -> y < y_end, () -> {
        fb_rect_span(x0, x_end, y, color);
        y = y + 1;
    });

    exit;
};

void fb_fill = (uint32 color) -> {
    fb_rect(0, 0, FB_WIDTH - 1, FB_HEIGHT - 1, color);

    exit;
};

void thead_dcache_clean_range = (uint64 start_addr, uint64 size) -> {
    uint64 line = start_addr & ~(THEAD_CMO_STRIDE - 1);
    uint64 end = start_addr + size;

    while(() -> line < end, () -> {
        cacheclean(line);
        line = line + THEAD_CMO_STRIDE;
    });

    cachefinal();
    exit;
};

void fb_border = (int32 x0, int32 y0, int32 x1, int32 y1, uint32 color, int32 thick) -> {
    fb_rect(x0, y0, x1, y0 + thick - 1, color);
    fb_rect(x0, y1 - thick + 1, x1, y1, color);
    fb_rect(x0, y0, x0 + thick - 1, y1, color);
    fb_rect(x1 - thick + 1, y0, x1, y1, color);
    exit;
};

ScreenObject screen_make_rect = (int32 x, int32 y, int32 width, int32 height, int32 vx, int32 vy, uint32 color) -> {
    return [0, x, y, width, height, vx, vy, color, 0];
};

int32 screen_text_width = (string text) -> {
    return text.length == 0 ? 1 : text.length * SCREEN_TEXT_CHAR_ADVANCE;
};

ScreenObject screen_make_text = (int32 x, int32 y, int32 vx, int32 vy, uint32 color, string text) -> {
    return screen_make_rect(x, y, screen_text_width(text), SCREEN_TEXT_HEIGHT, vx, vy, color);
};

int32 screen_object_kind = (ScreenObject object) -> {
    return int32(object[0]);
};

int32 screen_object_x = (ScreenObject object) -> {
    return int32(object[1]);
};

int32 screen_object_y = (ScreenObject object) -> {
    return int32(object[2]);
};

int32 screen_object_width = (ScreenObject object) -> {
    return int32(object[3]);
};

int32 screen_object_height = (ScreenObject object) -> {
    return int32(object[4]);
};

int32 screen_object_vx = (ScreenObject object) -> {
    return int32(object[5]);
};

int32 screen_object_vy = (ScreenObject object) -> {
    return int32(object[6]);
};

uint32 screen_object_color = (ScreenObject object) -> {
    return uint32(object[7]);
};

ScreenObject screen_object_with_state = (ScreenObject object, int32 x, int32 y, int32 vx, int32 vy) -> {
    return [
        screen_object_kind(object),
        x,
        y,
        screen_object_width(object),
        screen_object_height(object),
        vx,
        vy,
        screen_object_color(object),
        object[8]
    ];
};

ScreenObject screen_object_set_velocity = (ScreenObject object, int32 vx, int32 vy) -> {
    return screen_object_with_state(object, screen_object_x(object), screen_object_y(object), vx, vy);
};

ScreenObject screen_move_object = (ScreenObject object, int32 dx, int32 dy) -> {
    return screen_object_with_state(
        object,
        screen_object_x(object) + dx,
        screen_object_y(object) + dy,
        screen_object_vx(object),
        screen_object_vy(object)
    );
};

ScreenObject screen_step_object = (ScreenObject object) -> {
    return screen_move_object(object, screen_object_vx(object), screen_object_vy(object));
};

void screen_draw_object = (ScreenObject object) -> {
    fb_rect(
        screen_object_x(object),
        screen_object_y(object),
        screen_object_x(object) + screen_object_width(object) - 1,
        screen_object_y(object) + screen_object_height(object) - 1,
        screen_object_color(object)
    );
    exit;
};

void screen_clear_object = (ScreenObject object, uint32 color) -> {
    fb_rect(
        screen_object_x(object),
        screen_object_y(object),
        screen_object_x(object) + screen_object_width(object) - 1,
        screen_object_y(object) + screen_object_height(object) - 1,
        color
    );
    exit;
};