package app;

import lib.io.probe;
import lib.io.screen;
import lib.io.clock;
import lib.io.hdmi_tx;
import lib.io.dc8200;

import lib.loop;

static final int32 HDMI_PLL_SETTLE_DELAY_US = 5000;
static final int32 HDMI_POST_PHY_SETTLE_DELAY_US = 20000;
static final int32 HDMI_POST_SCANOUT_ENABLE_DELAY_US = 50000;

void scratch_mark = (int32 index, uint32 value) -> {
    mmio<uint32> scratch = 0x05000000;

    offset(scratch, index).value = value;
    fence();
    exit;
};

int32 hold_scanout = asm() -> {
1:
    nop
    j 1b
};

ScreenObject screen_demo_step_axis = (ScreenObject object, int32 max_pos, bool horizontal) -> {
    int32 pos = horizontal ? screen_object_x(object) : screen_object_y(object);
    int32 vel = horizontal ? screen_object_vx(object) : screen_object_vy(object);
    int32 next_pos = pos + vel;

    if(next_pos < 0 || next_pos > max_pos, () -> {
        vel = 0 - vel;
    });

    return horizontal
        ? screen_object_set_velocity(object, vel, screen_object_vy(object))
        : screen_object_set_velocity(object, screen_object_vx(object), vel);
};

ScreenObject screen_demo_step_bounds = (ScreenObject object) -> {
    int32 max_x = FB_WIDTH - screen_object_width(object);
    int32 max_y = FB_HEIGHT - screen_object_height(object);
    ScreenObject bounded = screen_demo_step_axis(object, max_x, true);

    bounded = screen_demo_step_axis(bounded, max_y, false);
    return screen_step_object(bounded);
};

void screen_demo_frame = (arr<?> sceneObjects) -> {
    fb_fill(RGB(0x00, 0x00, 0x00));
    forLinear(sceneObjects, (var group) -> {
        forLinear(group, (ScreenObject object) -> {
            screen_draw_object(object);
        });
    });
    thead_dcache_clean_range(0x04200000, 0x007E9000);
    exit;
};

int32 screen_demo_hold = (arr<?> sceneObjects) -> {
    screen_demo_frame(sceneObjects);
    return hold_scanout();
};

