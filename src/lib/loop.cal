package lib.loop;

import lib.loop_range;
import lib.loop_while;

void forPairs = (arr<?> arr1, arr<?> arr2, |var body) -> {
    int i1 = 0;
    int i2 = 0;
    if(arr1.length != arr2.length, () -> { throw "Arrays must be the same length."; });
    while(() -> i1 < arr1.length && i2 < arr2.length, () -> {
        body(arr1[i1], arr2[i2]);
        i1 = i1 + 1;
        i2 = i2 + 1;
    });
};

void forLinear = (arr<?> items, |var body) -> {
    int i = 0;
    while(() -> i < items.length, () -> {
        body(items[i]);
        i = i + 1;
    });
};