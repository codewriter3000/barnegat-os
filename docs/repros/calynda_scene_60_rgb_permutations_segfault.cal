type ScreenObject = arr<?>;

uint32 RGB = (uint32 r, uint32 g, uint32 b) -> {
    return (r << 16) | (g << 8) | b;
};

ScreenObject screen_make_object = (int32 x, int32 y, int32 vx, int32 vy, uint32 color) -> {
    return [0, x, y, 168, 32, vx, vy, color, 0];
};

