int32 loop = (arr<?> sceneObjects) -> {
    //scratch_mark(0, 0xAA100001);

    vosys_clk_enable();
    //scratch_mark(1, 0xAA100002);
    delay_us(500);

    dpu0_pll_configure_1080p60();
    dpu1_pll_configure_1080p60();
    //scratch_mark(2, 0xAA100003);
    delay_us(HDMI_PLL_SETTLE_DELAY_US);

    screen_demo_frame(sceneObjects);
    //scratch_mark(3, 0xAA100004);

    dw_hdmi_init();
    //scratch_mark(7, 0xAA100005);
    delay_us(HDMI_POST_PHY_SETTLE_DELAY_US);
    dc8200_init();
    //scratch_mark(8, 0xAA100006);
    delay_us(HDMI_POST_SCANOUT_ENABLE_DELAY_US);
    return screen_demo_hold(sceneObjects);
};

int32 hdmi_screen_demo = () -> {
    arr<?> sceneObjects = [
        screen_demo_heysyd()
    ];

    return loop(sceneObjects);
};

int32 hdmi_hello_world = () -> {
    ScreenObject title = screen_make_text(96, 72, 0, 0, RGB(0xFF, 0xFF, 0xFF), "BARNEGAT OS");
    ScreenObject subtitle = screen_make_text(96, 120, 0, 0, RGB(0x6F, 0xD3, 0xFF), "HDMI READY");

    //scratch_mark(0, 0xAA000001);

    vosys_clk_enable();
    //scratch_mark(1, 0xAA000002);
    delay_us(500);

    dpu0_pll_configure_1080p60();
    dpu1_pll_configure_1080p60();
    //scratch_mark(2, 0xAA000003);
    delay_us(HDMI_PLL_SETTLE_DELAY_US);

    fb_layout_probe();
    screen_draw_object(title);
    screen_draw_object(subtitle);
    fence();
    thead_dcache_clean_range(0x04200000, 0x007E9000);
    //scratch_mark(3, 0xAA000004);

    dw_hdmi_init();
    //scratch_mark(7, 0xAA000005);
    delay_us(HDMI_POST_PHY_SETTLE_DELAY_US);
    dc8200_init();
    //scratch_mark(8, 0xAA000006);
    delay_us(HDMI_POST_SCANOUT_ENABLE_DELAY_US);
    return hold_scanout();
};

int32 controller_demo_hold = () -> {
    return hold_scanout();
};

int32 hdmi_controller_demo = () -> {
    vosys_clk_enable();
    delay_us(500);

    dpu0_pll_configure_1080p60();
    dpu1_pll_configure_1080p60();
    delay_us(HDMI_PLL_SETTLE_DELAY_US);

    fb_fill(RGB(0x00, 0x00, 0x00));
    fence();
    thead_dcache_clean_range(0x04200000, 0x007E9000);

    dw_hdmi_init();
    delay_us(HDMI_POST_PHY_SETTLE_DELAY_US);
    dc8200_init();
    delay_us(HDMI_POST_SCANOUT_ENABLE_DELAY_US);
    return controller_demo_hold();
};



int32 run = manual() -> {
    return hdmi_screen_demo();
};

boot -> run();

