// merged from src/uart_hello.cal
package app;


// merged from src/machines/virt/lib/io/uart.cal

// QEMU virt: 16550-compatible UART at 0x10000000, byte writes
// a0 = char value; no status polling needed in QEMU
int32 uart_putc = asm(int32 ch) -> {
    li   t0, 0x10000000
    sb   a0, 0(t0)
    li   a0, 0
    ret
};


int32 uart_emit_and_step = manual(string msg, int32 index) -> {
    int32 ch = msg[index];
    int32 sent = uart_putc(ch);
    return uart_print_at(msg, index + 1);
};

int32 uart_print_at = manual(string msg, int32 index) -> {
    return index < msg.length ? uart_emit_and_step(msg, index) : 0;
};

int32 uart_print = manual(string msg) -> {
    return uart_print_at(msg, 0);
};

int32 run = manual() -> {
    return uart_print("Hello World");
};

boot -> run();

